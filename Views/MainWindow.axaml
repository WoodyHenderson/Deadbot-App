<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeadBot.ViewModels"
        xmlns:views="using:DeadBot.Views"
        xmlns:models="using:DeadBot.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="780"
        x:Class="DeadBot.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DeadBot — Deadlock Assistant"
        Width="1180" Height="780" MinWidth="900" MinHeight="650"
        Background="#10151D" Foreground="#F0F4FA"
        FontFamily="Inter, Segoe UI, sans-serif" FontSize="14">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="#B6C2D2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#DDE6F1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#10151D" />
            <Setter Property="Foreground" Value="#F0F4FA" />
            <Setter Property="BorderBrush" Value="#49576A" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#10151D" />
            <Setter Property="Foreground" Value="#F0F4FA" />
            <Setter Property="BorderBrush" Value="#49576A" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Button.send">
            <Setter Property="Background" Value="#70DEC9" />
            <Setter Property="Foreground" Value="#102923" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,12" />
        </Style>
        <Style Selector="Button.send:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#9AEBDD" />
            <Setter Property="Foreground" Value="#102923" />
        </Style>
        <Style Selector="Button.send:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#50C4AE" />
            <Setter Property="Foreground" Value="#102923" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Padding="28,22" Background="#151D28" BorderBrush="#2D394A" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="46" Height="46" CornerRadius="13" Background="#70DEC9" Margin="0,0,14,0">
                    <TextBlock Text="D" FontSize="26" FontWeight="Bold" Foreground="#102923"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="DeadBot" FontSize="23" FontWeight="Bold" />
                    <TextBlock Classes="secondary" Text="Your Deadlock knowledge companion" FontSize="13" />
                </StackPanel>
                <Border Grid.Column="2" Background="#23352F" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="OpenRouter ready" Foreground="#9AEBDD" FontSize="12" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="292,*" Margin="24" ColumnSpacing="24">
            <Border Background="#19222E" BorderBrush="#2D394A" BorderThickness="1" CornerRadius="14" Padding="20">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Workspace" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary" Text="Configure your assistant." Margin="0,0,0,16" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="label" Text="Model" />
                                <Border Background="#344356" CornerRadius="9" Width="18" Height="18"
                                        VerticalAlignment="Center" ToolTip.Tip="z-ai/glm-5.3-flash: lower-cost, faster reasoning.&#10;&#10;openai/gpt-5.6-luna: stronger reasoning for harder questions, but more expensive.&#10;&#10;Pricing and availability should be verified before use.">
                                    <TextBlock Text="i" Foreground="#9AEBDD" FontWeight="Bold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" />
                            <TextBlock Classes="secondary" Text="Requests are sent through your OpenRouter account." FontSize="12" />
                            <TextBlock Classes="label" Text="OpenRouter API key" Margin="0,16,0,0" />
                            <TextBox Text="{Binding ApiKey}" PasswordChar="●" Watermark="Paste your API key" />
                            <TextBlock Classes="secondary" Text="Key held in memory only. Sending shares your conversation and selected knowledgebase files with OpenRouter and its model provider." FontSize="12" />
                            <Border Background="#111A24" BorderBrush="#344356" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="label" Text="Knowledgebase" />
                                    <TextBlock Text="{Binding KnowledgebaseStatus}" Foreground="#9AEBDD" FontSize="12" />
                                    <TextBlock Classes="secondary" Text="Core rules plus named heroes/items. Patch search and build discovery are not implemented yet." FontSize="12" />
                                    <Button Content="Download data" Command="{Binding DownloadKnowledgebaseCommand}" Margin="0,6,0,0" />
                                    <TextBlock Classes="secondary" Text="{Binding KnowledgebasePath}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Classes="secondary" Text="Unofficial community project.&#10;Not affiliated with Valve." FontSize="12" Margin="0,20,0,0" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Ask about Deadlock" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Classes="secondary" Text="Heroes, items, builds, and mechanics — all in one conversation." />
                </StackPanel>

                <Border Grid.Row="1" Background="#19222E" BorderBrush="#2D394A" BorderThickness="1" CornerRadius="14" Padding="22">
                    <Grid RowDefinitions="Auto,*" RowSpacing="18">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="CONVERSATION" Foreground="#9AEBDD" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="New chat" Command="{Binding NewConversationCommand}" />
                            </Grid>
                            <Expander Header="Sources selected for latest request" HorizontalAlignment="Stretch">
                                <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
                                    <SelectableTextBlock Text="{Binding RetrievedSources}" TextWrapping="Wrap" FontSize="12" Foreground="#B6C2D2" />
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChatMessage">
                                        <Border Background="#141E29" BorderBrush="#344356" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="{Binding Role}" Foreground="#9AEBDD" FontWeight="SemiBold" FontSize="13" />
                                                <SelectableTextBlock IsVisible="{Binding IsUser}" Text="{Binding Content}" Foreground="#E2EAF4" TextWrapping="Wrap" FontSize="15" LineHeight="25" />
                                                <views:MarkdownMessage IsVisible="{Binding IsAssistant}" Markdown="{Binding Content}" HorizontalContentAlignment="Stretch" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#19222E" BorderBrush="#344356" BorderThickness="1" CornerRadius="14" Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <TextBlock Classes="label" Text="Your question" />
                        <TextBox Grid.Row="1" Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="90" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Watermark="e.g. How does spirit power affect hero abilities?" />
                        <Grid Grid.Row="2" ColumnDefinitions="*,120,Auto" ColumnSpacing="14">
                            <TextBlock Classes="secondary" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" IsVisible="{Binding IsSending}" IsIndeterminate="True"
                                         Height="4" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="send" Content="Send question →" Command="{Binding SendCommand}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
